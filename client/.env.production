# Production build settings (vite build). Committed on purpose: nothing here is
# secret. The Minilytics site key is public by design; it ships in the page.
# Cloudflare Pages builds production and branch previews in this mode, so
# previews send analytics too. Dev and the test suites never load this file.
PUBLIC_MINILYTICS_HOST=https://analytics.missingpiecetech.com
PUBLIC_MINILYTICS_SITE_ID=michael_vadney_author
PUBLIC_MINILYTICS_SITE_KEY=ba806f3e9a453c45c72b827c3fbac664d35ead78656a55ce
